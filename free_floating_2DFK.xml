<?xml version="1.0"?>
<mujoco model="planar_ffsms_com">
  <compiler angle="radian" inertiafromgeom="true" />
  <!-- option integrator="RK4" timestep="0.002" gravity="0 0 0" /-->
  <option timestep="0.002" gravity="0 0 0" integrator="RK4" />


  <default>
    <geom conaffinity="1" contype="1" friction="0.0 0.0 0.0" density="1000"/>
    <joint limited="false"/>
  </default>


  <worldbody>
      <!-- Large plane behind the model for background -->
    <body name="bg_plane" pos="0 0 -5">
        <geom type="plane" size="10 10 0.1" rgba="0.95 0.95 0.95 1"/>
    </body>
  <!-- Overhead directional light -->
    <light diffuse="0.1 0.1 0.1" ambient="0.1 0.1 0.1"
           pos="0 0 50" dir="0 0 -1"/>

    <!-- Fill lights >
    <light diffuse=".3 .3 .3" pos="5 5 5"/>
    <light diffuse=".3 .3 .3" pos="-5 -5 5"/-->
    <!--
      World origin is the INERTIAL FRAME = WHOLE-SYSTEM CENTER OF MASS.
      The base body is positioned at the base COM (N_r_b) computed
      for q = [0,0,0] and placed here so the world origin sits at system COM.
    -->
    <!--body name="base" pos="-0.05735208 0 0"-->
    <body name="base" pos="-0.0522 -0.0193 0">
      <!-- Planar floating base joints (restrict motion to plane: tx, ty, yaw) -->
      <joint name="base_tx" type="slide" axis="1 0 0" />
      <joint name="base_ty" type="slide" axis="0 1 0" />
      <joint name="base_yaw" type="hinge" axis="0 0 1" />

      <!-- Base geometry: box sized to lb/2 in x and y half-sizes -->
      <!-- <geom name="base_geom" type="box" pos="0 0 0" size="0.232 0.232 0.2415" mass="33.015" rgba="1 1 0.2 1"/> -->
      <geom name="base_geom" type="box" pos="0 0 0" size="0.232 0.232 0.2415" mass="100.015" rgba="1 1 0.2 1"/>

      <!-- Mounting point B_M_b is at +lb/2 along base x in base frame -->
      <body name="mount_point" pos="0.232 0 0">
        <!-- Joint 1: hinge about z (rotation q1) -->
        <joint name="joint1" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.3" />
        <!-- Link1: capsule from joint1 origin to l1 along +x -->
        <body name="link1" pos="0 0 0">
          <geom name="link1_geom" type="box" size="0.19 0.019 0.019" pos="0.19 0 0" mass="1.2" rgba="0.8 0.3 0.3 1"/>
          <!-- joint2 located at the end of link1 (x = l1) -->
          <body name="joint2_mount" pos="0.38 0 0">
            <joint name="joint2" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.3" />
            <body name="link2" pos="0 0 0">
              <geom name="link2_geom" type="box" size="0.19 0.019 0.019" pos="0.19 0 0" mass="1.2" rgba="0.3 0.8 0.3 1"/>
              <!-- joint3 located at end of link2 -->
              <body name="joint3_mount" pos="0.38 0 0">
                <joint name="joint3" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.3" />
                <body name="link3" pos="0 0 0">
                  <geom name="link3_geom" type="box" size="0.19 0.019 0.019" pos="0.19 0 0" mass="0.5" rgba="0.3 0.3 0.8 1"/>
                  <site name="ee_site" pos="0.38 0 0" size="0.01" type="sphere" rgba="1 0 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <!-- torque actuators on the manipulator joints -->
    <motor joint="joint1" gear="1"/>
    <motor joint="joint2" gear="1"/>
    <motor joint="joint3" gear="1"/>
  </actuator>

<sensor>
    <jointpos joint="joint1" name="q1"/>
    <jointpos joint="joint2" name="q2"/>
    <jointpos joint="joint3" name="q3"/>

    <jointpos joint="base_tx" name="base_x"/>
    <jointpos joint="base_ty" name="base_y"/>
    <jointpos joint="base_yaw" name="base_yaw"/>

    <!-- Correct way to get end-effector site position -->
    <framepos objtype="site" objname="ee_site" name="ee_pos"/>
</sensor>

 <keyframe>
  <key name="home" qpos="0 0 0 0 0 0"/>
  <!--key name="home" qpos="0 0 0   0.523599 0 0"/--> 
  </keyframe>

</mujoco>
